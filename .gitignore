# Root-level ignores. Each v00N/ carries its own .gitignore for its self-contained
# build/runtime output; these are belt-and-suspenders in case artifacts land at the
# root or a new version dir before its own .gitignore is in place.

# CMake / Ninja build trees (any version, any depth)
build/
build-*/
**/build/
**/build-*/

# Local matrix run artifacts — persist files ignored; .log text committable
**/test-results/**
!**/test-results/**/
!**/test-results/**/*.log
!**/test-results/README.md

# Retained durable captures (--keep-logs); README + .log in each version may be tracked
**/kept-logs/**
!**/kept-logs/**/
!**/kept-logs/**/*.log
!**/kept-logs/README.md

# Compiled objects, archives, module artifacts, local binaries
*.o
*.a
*.so
*.dylib
*.gcm
*.dd
*.ddi
*.modmap
*.out

# IDE / editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Jac313Runner GUI build output (jac313_test_cli gui-build -> <root>/gui/out/)
gui/out/

# Jac313Runner run summaries and "Copy for AI" reports: they name the PostgreSQL servers used
/v*/test-summary/runner_last*.json
/v*/test-summary/runner_last*.json.parts
/v*/test-summary/*_ai.md

# The shared results DB is local to each machine (the CLI creates it when missing)
test-summary/results.db
