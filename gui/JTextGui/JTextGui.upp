description "jText table editor, vendored from jText_GUI\n";

noblitz;

uses
	CtrlLib;

file
	main.cpp,
	core/jtext_store.cpp,
	core/session_ops.cpp,
	core/sqlite_store.cpp,
	core/maria_postgres_store.cpp,
	core/connections_file.cpp,
	core/spreadsheet.cpp,
	core/comments_table.cpp,
	jText/jText.cpp,
	jText/src/parser/line.cpp,
	jText/src/parser/section.cpp,
	jText/src/parser/close.cpp,
	jText/src/validator/validator.cpp,
	jText/src/export/xml_export.cpp;

options
	"-Iinclude -IjText -IjText/src -I/usr/pgsql-18/include -I/usr/include/mysql -DJTEXT_HAS_POSTGRESQL -DJTEXT_HAS_MARIADB";

library
	sqlite3,
	pq,
	mariadb,
	z;

link
	"-L/usr/pgsql-18/lib";

mainconfig
	"" = "GUI WAYLAND";

options
	"-Wformat=2 -Werror=format";
