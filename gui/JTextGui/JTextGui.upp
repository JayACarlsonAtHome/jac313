description "jText table editor, vendored from jText_GUI\n";

noblitz;

uses
	CtrlLib;

file
	main.cpp,
	core/jtext_store.cpp,
	core/session_ops.cpp,
	core/sqlite_store.cpp,
	core/maria_postgres_store.cpp,
	core/connections_file.cpp,
	jText/jText.cpp,
	jText/src/parser/line.cpp,
	jText/src/parser/section.cpp,
	jText/src/validator/validator.cpp;

options
	"-Iinclude -IjText -IjText/src -I/usr/pgsql-17/include -DJTEXT_HAS_POSTGRESQL";

library
	sqlite3,
	pq;

link
	"-L/usr/pgsql-17/lib";

mainconfig
	"" = "GUI WAYLAND";
