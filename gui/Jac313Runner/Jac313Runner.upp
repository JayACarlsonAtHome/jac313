description "jac315 Jac313Runner — run the jac313 test gates (jac313_test_cli), watch them, and view the persisted datasets as jText\n";

noblitz;

uses
	CtrlLib,
	plugin/png;

file
	Model.h,
	Model.cpp,
	main.cpp,
	../JTextGui/jText/jText.cpp,
	../JTextGui/jText/src/parser/line.cpp,
	../JTextGui/jText/src/parser/section.cpp;

mainconfig
	"" = "GUI WAYLAND";

options
	"-I../JTextGui/jText -I../JTextGui/jText/src -Wformat=2 -Werror=format";
