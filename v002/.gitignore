# CMake / Ninja build trees
build/
build-*/
**/build/

# Throwaway build-matrix trees + their logs (tools/build_matrix.sh) — one place, wholesale-deletable
/tmp_build/
/tmp_build*

# Compiled objects and archives
*.o
*.a
*.so
*.dylib

# Module artifacts (GCC)
*.gcm
*.dd
*.ddi
*.modmap

# Executables (local smoke/test binaries)
*.out

# IDE / editor
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Local scratch (smoke monitor + ad-hoc helpers)
/.tmp_*

# Local matrix run artifacts (all ignored)
test-results/
# Retained durable captures (--keep-logs); README + .log text are tracked
kept-logs/**
!kept-logs/**/
!kept-logs/**/*.log
!kept-logs/README.md
bench-json-output/*.json

# Matrix persist spillover at repo root (cwd-relative test output)
/persist*

# store_bench durable output at the v002 root (cwd-relative: bench.bin / .jtext / .sql / .db)
# Note: only root-level; test-summary/ is ignored by the root .gitignore.
/bench*

# Auto-generated, per-machine sensed-environment snapshot (informational only)
/FileCheckList.txt

# Machine-local host label (anonymizes results: hostname() reads this instead of uname)
/host_label.local

# Left behind by older bootstraps (they wrote these; bsir.sh no longer does)
/Setup.sh
/Setup/.setup_handoff

# Convenience symlinks to the bootstrap-built tools (targets live in gitignored build-bootstrap/)
/jac313_test_cli
/jac313_wipe_all
/jac313_wipe_one
/jac313_wipe_jac

# Generated, re-runnable preset script (overwritten each preset invocation)
/run_latest_config.sh
/run-log.txt

# Jac313Runner / JTextGui build output (jac313_test_cli gui-build -> gui/out/)
gui/out/
